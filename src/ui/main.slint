import { VerticalBox, HorizontalBox, Button, ScrollView } from "std-widgets.slint";

export component MainWindow inherits Window {
    preferred-width: 800px;
    preferred-height: 600px;
    background: transparent;
    no-frame: true;

    property<int> mouse-start-x;
    property<int> mouse-start-y;
    property<int> mouse-current-x;
    property<int> mouse-current-y;
    property<bool> is-selecting: false;

    // 截图图像
    property<image> screenshot-image;

    // 工具栏状态
    property<bool> show-tools: true;

    callback capture-area();
    callback cancel-screenshot();
    callback save-screenshot();

    in property <length> window-width;
    in property <length> window-height;

    Rectangle {
        background: rgba(0, 0, 0, 0.3);
        touch-events: true;
        width: root.width;
        height: root.height;

        // 截图显示区域
        Rectangle {
            background: white;
            width: root.screenshot-image.width;
            height: root.screenshot-image.height;
            x: (parent.width - width) / 2;
            y: 0;

            Image {
                source: root.screenshot-image;
                width: parent.width;
                height: parent.height;
            }

            // 选择区域矩形
            Rectangle {
                background: rgba(255, 255, 255, 0.3);
                border-color: #2196F3;
                border-width: 2px;
                x: min(root.mouse-start-x, root.mouse-current-x);
                y: min(root.mouse-start-y, root.mouse-current-y);
                width: abs(root.mouse-current-x - root.mouse-start-x);
                height: abs(root.mouse-current-y - root.mouse-start-y);
                visible: root.is-selecting && width > 5 && height > 5;
            }
        }

        // 工具栏容器 - 固定在截图下方
        Rectangle {
            background: #2C2C2C;
            border-radius: 8px;
            width: 400px;
            height: 60px;
            x: (parent.width - width) / 2;
            y: root.screenshot-image.height + 20px;
            visible: root.show-tools;

            HorizontalBox {
                spacing: 10px;
                alignment: center;

                // 标注工具
                ToolButton {
                    text: "矩形";
                    icon: "rect";
                    clicked => {
                        // 矩形标注逻辑
                    }
                }

                ToolButton {
                    text: "箭头";
                    icon: "arrow";
                    clicked => {
                        // 箭头标注逻辑
                    }
                }

                ToolButton {
                    text: "画笔";
                    icon: "brush";
                    clicked => {
                        // 画笔标注逻辑
                    }
                }

                ToolButton {
                    text: "文字";
                    icon: "text";
                    clicked => {
                        // 文字标注逻辑
                    }
                }

                // 操作按钮
                Button {
                    text: "保存";
                    background: #4CAF50;
                    clicked => {
                        root.save-screenshot();
                    }
                }

                Button {
                    text: "取消";
                    background: #F44336;
                    clicked => {
                        root.cancel-screenshot();
                    }
                }

                Button {
                    text: "区域选择";
                    background: #2196F3;
                    clicked => {
                        root.capture-area();
                    }
                }
            }
        }
    }

    // 鼠标事件处理
    touch-event => {
        if (pressed) {
            root.mouse-start-x = position.x;
            root.mouse-start-y = position.y;
            root.mouse-current-x = position.x;
            root.mouse-current-y = position.y;
            root.is-selecting = true;
        } else if (moved && root.is-selecting) {
            root.mouse-current-x = position.x;
            root.mouse-current-y = position.y;
        } else {
            root.is-selecting = false;
        }
    }
}

component ToolButton inherits Button {
    property<string> icon;
    height: 40px;
    min-width: 60px;

    in property <brush> background: @linear-gradient(90deg, #4A4A4A 0%, #5A5A5A 100%);

    Text {
        text: parent.text;
        color: white;
        font-size: 12px;
        horizontal-alignment: center;
    }
}